# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for database and authentication.
# Get these from your Supabase project settings.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Port (default 3000)
PORT=3000

# Optional Supabase credentials (if connecting to external Supabase instance)
# The application includes a full-stack persistent database and auth server out of the box.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
